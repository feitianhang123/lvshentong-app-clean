@echo off
echo 🌟 绿申通快速开始指南
echo ============================
echo.
echo 📱 推荐方案：使用 HBuilder（最简单）
echo.
echo 请按以下步骤操作：
echo 1. 下载 HBuilderX: https://www.dcloud.io/hbuilderx.html
echo 2. 安装并打开 HBuilderX
echo 3. 选择 "文件" → "打开目录"
echo 4. 选择 "cordova-project" 文件夹
echo 5. 点击 "发行" → "原生App-云打包"
echo 6. 设置应用信息后点击 "打包"
echo.
echo 📋 备用方案：Android Studio
echo.
echo 如果坚持使用 Android Studio：
echo 1. 打开 Android Studio
echo 2. 点击 "File" → "Open"
echo 3. 选择 "android-project" 文件夹
echo 4. 等待配置完成
echo 5. 点击 "Build" → "Make Project"
echo.
echo 📦 APK 文件位置：
echo android-project\app\build\outputs\apk\debug\app-debug.apk
echo.
echo 📚 详细指南请查看：
echo - hbuilder-guide.md (HBuilder使用指南)
echo - auto-build.bat (环境检查脚本)
echo.
pause